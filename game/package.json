{
  "name": "baize-rich",
  "version": "0.3.0",
  "private": true,
  "description": "白泽秘境大富翁：像素风、凡人流修仙的大富翁式桌游（Phaser 3 + TypeScript）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SmartStudio/baize-rich.git",
    "directory": "game"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "sim": "tsx src/sim/run.ts",
    "board": "tsx src/sim/board.ts",
    "sweep": "tsx src/sim/sweep.ts",
    "matchup": "tsx src/sim/matchup.ts",
    "lever": "tsx src/sim/lever.ts",
    "replay": "tsx src/sim/replay.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "shots": "node scripts/screenshots.cjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
